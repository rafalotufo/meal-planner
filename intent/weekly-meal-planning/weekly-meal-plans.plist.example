<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.meal-planner.weekly-drafts</string>
  <key>ProgramArguments</key><array>
    <string>ABSOLUTE_NODE24</string>
    <string>--env-file=.env.local</string>
    <string>--import</string><string>tsx</string>
    <string>scripts/generate-meal-plans.ts</string>
  </array>
  <key>WorkingDirectory</key><string>PRIVATE_PROJECT</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
</dict></plist>
