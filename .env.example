BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-generated-secret
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
RECIPE_SEARCH_PROVIDER=openai
OPENAI_API_KEY=replace-with-existing-project-key
OPENAI_RECIPE_MODEL=gpt-6.2-sol
# Vercel build setting: also set this in the Vercel project environment.
ENABLE_EXPERIMENTAL_COREPACK=1

# Populated by pnpm run db:setup into .env.local (server-only; never publish).
# DATABASE_URL: restricted runtime role, local PostgreSQL or future Neon pooled URL.
# MIGRATION_DATABASE_URL: separate schema owner; future Neon direct endpoint.
# TEST_DATABASE_URL: dedicated loopback-only mp_test role, never hosted/prod.
# Remote runtime/migration URLs require a single sslmode=verify-full.

# Weekly draft worker: full English weekday, Toronto at/after09:00. Unset=Thursday.
# Template only; scheduler installation/activation requires separate authorization.
MEAL_PLAN_DRAFT_DAY=Thursday
