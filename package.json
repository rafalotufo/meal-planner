{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --import tsx --test tests/auth/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-db.ts",
    "test:family": "node --import tsx --test tests/family/*.test.ts",
    "test": "tsc -p tsconfig.recipes-test.json && node --test build/recipe-tests/tests/recipe-*.test.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "better-auth": "1.7.27",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "htmlparser2": "10.1.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
