{
  "name": "meal-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx lib/db/verify-runtime-metadata.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --import tsx --test tests/auth/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-db.ts",
    "test:family": "node --import tsx --test tests/family/*.test.ts",
    "test:menu": "node --import tsx --test tests/menu/*.test.ts",
    "test": "tsc -p tsconfig.recipes-test.json && node --test build/recipe-tests/tests/recipe-*.test.js",
    "db:setup": "node --import tsx scripts/postgres-local.ts setup",
    "db:start": "node --import tsx scripts/postgres-local.ts start",
    "db:stop": "node --import tsx scripts/postgres-local.ts stop",
    "db:status": "node --import tsx scripts/postgres-local.ts status",
    "test:plans": "node --import tsx --test tests/plans/*.test.ts",
    "plans:generate": "node --env-file=.env.local --import tsx scripts/generate-meal-plans.ts",
    "test:migrations": "node --import tsx --test tests/migrations/*.test.ts",
    "db:check": "node --env-file=.env.local --import tsx scripts/check-db.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "3.11.3",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "htmlparser2": "10.1.0",
    "ipaddr.js": "2.5.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
