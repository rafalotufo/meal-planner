  {
    "kind": "constraint",
    "name": "app_users.app_users_family_id_fkey",
    "definition": "FOREIGN KEY (family_id) REFERENCES families(id) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "app_users.app_users_family_kind",
    "definition": "FOREIGN KEY (family_id, identity_kind) REFERENCES families(id, identity_kind) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "app_users.app_users_identity_branch",
    "definition": "CHECK ((((identity_kind = 'google'::text) AND (google_subject IS NOT NULL) AND (verified_email IS NOT NULL) AND (verification_run_id IS NULL) AND (length(TRIM(BOTH FROM google_subject)) > 0) AND (verified_email = lower(TRIM(BOTH FROM verified_email))) AND (length(verified_email) > 0)) OR ((identity_kind = 'verification'::text) AND (google_subject IS NULL) AND (verified_email IS NULL) AND (invitation_granted_at IS NULL) AND (verification_run_id IS NOT NULL) AND (id ~ '^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'::text))))"
  },
  {
    "kind": "constraint",
    "name": "app_users.app_users_member_run_unique",
    "definition": "UNIQUE (id, verification_run_id)"
  },
  {
    "kind": "constraint",
    "name": "app_users.app_users_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "kind": "constraint",
    "name": "app_users.app_users_run_family",
    "definition": "FOREIGN KEY (verification_run_id, family_id) REFERENCES verification_runs(id, family_id) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "app_users.email_normalized",
    "definition": "CHECK (((verified_email = lower(TRIM(BOTH FROM verified_email))) AND (length(verified_email) > 0)))"
  },
  {
    "kind": "constraint",
    "name": "app_users.subject_nonempty",
    "definition": "CHECK ((length(TRIM(BOTH FROM google_subject)) > 0))"
  },
  {
    "kind": "constraint",
    "name": "families.families_id_kind_unique",
    "definition": "UNIQUE (id, identity_kind)"
  },
  {
    "kind": "constraint",
    "name": "families.families_identity_kind",
    "definition": "CHECK ((identity_kind = ANY (ARRAY['google'::text, 'verification'::text])))"
  },
  {
    "kind": "constraint",
    "name": "families.families_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.family_invitations_accepted_by_user_id_fkey",
    "definition": "FOREIGN KEY (accepted_by_user_id) REFERENCES app_users(id) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.family_invitations_created_by_user_id_fkey",
    "definition": "FOREIGN KEY (created_by_user_id) REFERENCES app_users(id) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.family_invitations_family_id_fkey",
    "definition": "FOREIGN KEY (family_id) REFERENCES families(id) ON DELETE RESTRICT"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.family_invitations_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.invitation_deadline",
    "definition": "CHECK ((expires_at > created_at))"
  },
  {
    "kind": "constraint",
    "name": "family_invitations.invitation_state",
    "definition": "CHECK ((((status = 'pending'::text) AND (accepted_by_user_id IS NULL) AND (accepted_at IS NULL) AND (revoked_at IS NULL)) OR ((status = 'accepted'::text) AND (accepted_by_user_id IS NOT NULL) AND (accepted_at IS NOT NULL) AND (revoked_at IS NULL)) OR ((status = 'revoked'::text) AND (accepted_by_user_id IS NULL) AND (accepted_at IS NULL) AND (revoked_at IS NOT NULL))))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_approvals.meal_plan_approvals_created_at_check",
    "definition": "CHECK (((created_at >= 0) AND (created_at <= '9007199254740991'::bigint)))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_approvals.meal_plan_approvals_pkey",
    "definition": "PRIMARY KEY (plan_id, user_id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_approvals.meal_plan_approvals_plan_id_fkey",
    "definition": "FOREIGN KEY (plan_id) REFERENCES meal_plan_weeks(id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_approvals.meal_plan_approvals_revision_check",
    "definition": "CHECK ((revision > 0))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_approvals.meal_plan_approvals_user_id_fkey",
    "definition": "FOREIGN KEY (user_id) REFERENCES app_users(id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_base_revision_check",
    "definition": "CHECK ((base_revision > 0))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_created_at_check",
    "definition": "CHECK (((created_at >= 0) AND (created_at <= '9007199254740991'::bigint)))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_day_index_check",
    "definition": "CHECK (((day_index >= 0) AND (day_index <= 6)))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_id_check",
    "definition": "CHECK ((id ~ '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'::text))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_menu_recipe_id_check",
    "definition": "CHECK ((menu_recipe_id ~ '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'::text))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_plan_id_fkey",
    "definition": "FOREIGN KEY (plan_id) REFERENCES meal_plan_weeks(id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_recipe_check",
    "definition": "CHECK ((jsonb_typeof(recipe) = 'object'::text))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_status_check",
    "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'accepted'::text, 'rejected'::text, 'stale'::text])))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_suggestions.meal_plan_suggestions_user_id_fkey",
    "definition": "FOREIGN KEY (user_id) REFERENCES app_users(id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_check",
    "definition": "CHECK ((((status = 'draft'::text) AND (finalized_at IS NULL)) OR ((status = 'final'::text) AND (finalized_at IS NOT NULL))))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_created_at_check",
    "definition": "CHECK (((created_at >= 0) AND (created_at <= '9007199254740991'::bigint)))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_family_id_fkey",
    "definition": "FOREIGN KEY (family_id) REFERENCES families(id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_family_id_week_start_key",
    "definition": "UNIQUE (family_id, week_start)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_finalized_at_check",
    "definition": "CHECK (((finalized_at >= 0) AND (finalized_at <= '9007199254740991'::bigint)))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_id_check",
    "definition": "CHECK ((id ~ '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'::text))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_meals_check",
    "definition": "CHECK (((jsonb_typeof(meals) = 'array'::text) AND ((jsonb_array_length(meals) >= 1) AND (jsonb_array_length(meals) <= 7))))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_revision_check",
    "definition": "CHECK ((revision > 0))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_status_check",
    "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'final'::text])))"
  },
  {
    "kind": "constraint",
    "name": "meal_plan_weeks.meal_plan_weeks_week_start_check",
    "definition": "CHECK (((EXTRACT(dow FROM week_start) = (0)::numeric) AND ((week_start >= '0001-01-01'::date) AND (week_start <= '9999-12-31'::date))))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_curation_email",
    "definition": "CHECK (((length(verified_email) >= 3) AND (length(verified_email) <= 254) AND (verified_email = lower(btrim(verified_email)))))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_curation_lease",
    "definition": "CHECK (((state = 'processing'::text) = (lease IS NOT NULL)))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_curation_state",
    "definition": "CHECK ((state = ANY (ARRAY['pending'::text, 'processing'::text, 'ready'::text, 'failed'::text])))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_curation_subject",
    "definition": "CHECK (((length(google_subject) >= 1) AND (length(google_subject) <= 255) AND (google_subject = btrim(google_subject))))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_curation_timestamps",
    "definition": "CHECK (((scheduled_at >= 0) AND (scheduled_at <= '9007199254740991'::bigint) AND (expires_at >= scheduled_at) AND (expires_at <= (scheduled_at + 30000)) AND (credential_expires_at >= expires_at) AND (credential_expires_at <= '9007199254740991'::bigint)))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_recipe_curations_entry_id_fkey",
    "definition": "FOREIGN KEY (entry_id) REFERENCES menu_recipes(id) ON DELETE CASCADE"
  },
  {
    "kind": "constraint",
    "name": "menu_recipe_curations.menu_recipe_curations_pkey",
    "definition": "PRIMARY KEY (entry_id)"
  },
  {
    "kind": "constraint",
    "name": "menu_recipes.menu_image_bound",
    "definition": "CHECK (((image_url IS NULL) OR ((octet_length(image_url) >= 1) AND (octet_length(image_url) <= 2048) AND (image_url = TRIM(BOTH FROM image_url)))))"
  },
  {
    "kind": "constraint",
    "name": "menu_recipes.menu_recipes_family_id_fkey",
    "definition": "FOREIGN KEY (family_id) REFERENCES families(id) ON DELETE RESTRICT"
  },
  {
