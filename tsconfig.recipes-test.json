{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "build/recipe-tests",
    "types": ["node"]
  },
  "include": ["lib/recipes/**/*.ts"],
  "exclude": ["lib/recipes/server.ts"]
}
